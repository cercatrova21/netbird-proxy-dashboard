# --- NetBird Management API ---
# Domain of your self-hosted NetBird Management server (NO trailing slash).
# This is the same domain your NetBird dashboard/API is served from
# (e.g. https://netbird.example.com).
NB_API_BASE=https://netbird.example.com

# Personal Access Token OR Service User token with read access to "Events".
# Create one under: NetBird Dashboard -> Settings -> Service Users (or your own
# account) -> Personal Access Tokens.
NB_API_TOKEN=nbp_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Network / access ---
# The IP the dashboard should bind to - use a private/VPN-only interface
# (e.g. your NetBird WireGuard IP, typically in the 100.x.x.x CGNAT range)
# so the dashboard is reachable only over that network and not the public
# internet. Find it with: netbird status   OR   ip a show wt0
DASHBOARD_BIND_IP=100.64.0.1
DASHBOARD_PORT=8098

# --- Poller ---
POLL_INTERVAL_SECONDS=30
# How many days to back-fill on first start (initial population of the local
# SQLite DB). Should be a bit higher than the access-log retention configured
# on the NetBird management side, so nothing is missed.
INITIAL_BACKFILL_DAYS=7

# --- Retention ---
# Delete events older than N days from the local SQLite DB (0 = never delete).
# Runs at most once per hour as part of the poller loop.
RETENTION_DAYS=0

# How many denies from a single source IP within the selected time range
# before the dashboard flags it as an anomaly ("IP with unusually many denies").
ANOMALY_DENY_THRESHOLD=10

# How long (in seconds) a /api/stats response is cached per unique
# range+filter combination, so repeated auto-refreshes / multiple open tabs
# don't recompute the same aggregates from scratch.
STATS_CACHE_SECONDS=20

TZ=Europe/Zurich
