# --- NetBird Management API ---
# Domain deines self-hosted NetBird Management-Servers (OHNE trailing slash).
# Das ist dieselbe Domain, ueber die auch das Dashboard/die API laufen (z.B. https://netbird.example.com).
NB_API_BASE=https://netbird.example.com

# Personal Access Token ODER Service-User-Token mit Leserecht auf "Events".
# Erstellen unter: NetBird Dashboard -> Settings -> Service Users (oder eigenes Nutzerkonto) -> Personal Access Tokens
NB_API_TOKEN=nbp_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Netzwerk / Zugriff ---
# Deine eigene NetBird-IP (WireGuard-Interface, meist im 100.x.x.x CGNAT-Bereich).
# Ermitteln mit: netbird status   ODER   ip a show wt0
# Nur ueber diese IP ist das Dashboard erreichbar -> automatisch "NetBird-Only".
DASHBOARD_BIND_IP=100.64.0.1
DASHBOARD_PORT=8098

# --- Poller ---
POLL_INTERVAL_SECONDS=30
# Wie viele Tage beim allerersten Start rueckwirkend geladen werden (Erstbefuellung der lokalen SQLite-DB).
# Sinnvoll etwas hoeher als AccessLogRetentionDays auf der Management-Seite, damit nichts fehlt.
INITIAL_BACKFILL_DAYS=7

# --- Aufbewahrung ---
# Events aelter als N Tage werden aus der lokalen SQLite-DB geloescht (0 = nie loeschen).
# Laeuft max. 1x/Stunde im Poller-Loop mit.
RETENTION_DAYS=0

# Ab wie vielen Denies einer einzelnen Quell-IP im gewaehlten Zeitraum das
# Dashboard sie als Anomalie ("IP mit auffaelligen vielen Denies") anzeigt.
ANOMALY_DENY_THRESHOLD=10

# Wie lange (in Sekunden) eine /api/stats-Antwort pro eindeutiger
# Range+Filter-Kombination gecacht wird, damit wiederholte Auto-Refreshes /
# mehrere offene Tabs nicht dieselben Aggregate neu berechnen.
STATS_CACHE_SECONDS=20

# --- CrowdSec (optional) ---
# Liest Alerts/Bans der lokalen CrowdSec-LAPI mit, die auch den netbird-proxy
# Bouncer versorgt. Siehe crowdsec/README.md fuer das Aufsetzen dieser LAPI und
# des dazugehoerigen netbird-logparser-Containers (AGENT_USERNAME/AGENT_PASSWORD
# dort) - nur die Machine-Rolle hier sieht Alerts inkl. GeoIP/AS-Anreicherung,
# der Bouncer-Key liefert nur nackte aktive Decisions.
# Leer lassen = Feature deaktiviert, Dashboard laeuft normal weiter.
CROWDSEC_API_URL=http://192.168.1.10:8080
CROWDSEC_MACHINE_ID=netbird-proxy-dashboard
CROWDSEC_MACHINE_PASSWORD=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Host-Pfad zur lokalen CrowdSec-Whitelist-Datei von netbird-logparser. Das Dashboard
# bekommt sie read-write gemountet, um Eintraege im Whitelist-Widget zu verwalten,
# sowie Zugriff auf den Docker-Socket, um netbird-logparser ueber den "Anwenden"-
# Knopf neu zu starten (CrowdSec laedt Parser-Config nur beim Start neu ein).
WHITELIST_HOST_FILE_PATH=/opt/netbird/netbird-logparser/postoverflows/s01-whitelist/netbird-proxy-whitelist.yaml
WHITELIST_CONTAINER_NAME=netbird-logparser

# --- ASN-Anreicherung (optional) ---
# Reichert jeden Request um Autonomous-System-Nummer/-Name der Quell-IP an (Top-ASNs-
# Chart, ASN als Cross-Filter). Laedt dafuer einmalig + woechentlich die kostenlose,
# unauthentifizierte GeoLite2-ASN-Datenbank herunter, die auch CrowdSecs eigene Hub-
# Parser nutzen - kein MaxMind-Account noetig. Bewusst per Default aus: einziges
# Feature hier, das selbststaendig etwas aus dem Internet nachlaedt.
ASN_ENRICHMENT_ENABLED=false
# Nur setzen, falls du einen eigenen Mirror/MaxMind-Download statt des CrowdSec-
# Hub-Downloads verwenden willst - leer lassen nutzt den Default aus docker-compose.yml.
ASN_MMDB_URL=

TZ=Europe/Zurich
